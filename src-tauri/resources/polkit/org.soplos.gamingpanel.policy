<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Soplos Linux</vendor>
  <vendor_url>https://soplos.org</vendor_url>

  <action id="org.soplos.gamingpanel.run-privileged">
    <description>Install GameMode and MangoHud with Soplos Gaming Panel</description>
    <message>Authentication is required to install the tools that the gaming panel controls</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/soplos-gaming-panel</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--run-ops</annotate>
  </action>

  <!-- The gaming tweaks, the sensor chips and the unit of the panel: a closed
       list of files the package ships, checked again as root. The person at
       the desk does them without a password; installing stays above. -->
  <action id="org.soplos.gamingpanel.run-tweaks">
    <description>Apply the gaming tweaks of Soplos Gaming Panel</description>
    <message>Authentication is required to apply the gaming tweaks</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/soplos-gaming-panel</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--run-tweaks</annotate>
  </action>
</policyconfig>
